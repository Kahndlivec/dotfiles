{
  "title": "HHKB diamond layer",
  "rules": [
    {
      "description": "Diamond: layer when held, Escape when tapped",
      "manipulators": [{
        "type": "basic",
        "from": { "key_code": "japanese_pc_xfer", "modifiers": { "optional": ["any"] } },
        "to": [{ "set_variable": { "name": "hhkb", "value": 1 } }],
        "to_after_key_up": [{ "set_variable": { "name": "hhkb", "value": 0 } }],
        "to_if_alone": [{ "key_code": "escape" }]
      }]
    },
    {
      "description": "Diamond + ERDFCV = brackets",
      "manipulators": [
        { "type": "basic", "conditions": [{ "type": "variable_if", "name": "hhkb", "value": 1 }],
          "from": { "key_code": "e", "modifiers": { "optional": ["any"] } },
          "to": [{ "key_code": "open_bracket",  "modifiers": ["left_shift"] }] },
        { "type": "basic", "conditions": [{ "type": "variable_if", "name": "hhkb", "value": 1 }],
          "from": { "key_code": "r", "modifiers": { "optional": ["any"] } },
          "to": [{ "key_code": "close_bracket", "modifiers": ["left_shift"] }] },
        { "type": "basic", "conditions": [{ "type": "variable_if", "name": "hhkb", "value": 1 }],
          "from": { "key_code": "d", "modifiers": { "optional": ["any"] } },
          "to": [{ "key_code": "9", "modifiers": ["left_shift"] }] },
        { "type": "basic", "conditions": [{ "type": "variable_if", "name": "hhkb", "value": 1 }],
          "from": { "key_code": "f", "modifiers": { "optional": ["any"] } },
          "to": [{ "key_code": "0", "modifiers": ["left_shift"] }] },
        { "type": "basic", "conditions": [{ "type": "variable_if", "name": "hhkb", "value": 1 }],
          "from": { "key_code": "a", "modifiers": { "optional": ["any"] } },
          "to": [{ "key_code": "comma",  "modifiers": ["left_shift"] }] },
        { "type": "basic", "conditions": [{ "type": "variable_if", "name": "hhkb", "value": 1 }],
          "from": { "key_code": "s", "modifiers": { "optional": ["any"] } },
          "to": [{ "key_code": "period", "modifiers": ["left_shift"] }] }
      ]
    }
  ]
}
