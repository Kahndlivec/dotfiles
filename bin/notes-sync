#!/usr/bin/env bash
# Save the notes: commit and push to GitHub. That's the whole sync — the iPad
# clones the same repo with Working Copy and reads it in Orgro.
#
#   notes-push        (terminal)        SPC n p   (Emacs)
#
# Nothing runs on a schedule; this is the checkpoint.
set -uo pipefail
NOTES="${NOTES_DIR:-$HOME/Documents/notes}"

[[ -d "$NOTES" ]] || { echo "notes-sync: $NOTES does not exist"; exit 1; }
if [[ ! -d "$NOTES/.git" ]]; then
  echo "notes-sync: $NOTES isn't a git repo yet — run: ~/dotfiles/install.sh notes"
  exit 1
fi

git -C "$NOTES" add -A
if git -C "$NOTES" diff --cached --quiet; then
  echo "notes-sync: nothing new to commit"
else
  git -C "$NOTES" commit -qm "notes $(date '+%Y-%m-%d %H:%M')" && echo "notes-sync: committed"
fi

if git -C "$NOTES" remote | grep -qx origin; then
  # Someone may have committed from the iPad (Working Copy) or the other machine.
  git -C "$NOTES" pull -q --rebase --autostash 2>/dev/null || echo "notes-sync: pull failed — check for conflicts"
  git -C "$NOTES" push -q && echo "notes-sync: pushed to GitHub" \
    || echo "notes-sync: push failed (offline? run: git -C $NOTES push)"
else
  echo "notes-sync: no GitHub remote — run: ~/dotfiles/install.sh notes"
fi
