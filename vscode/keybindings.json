[
    // ═══════════════════════════════════════════════════════════════════════
    //  VS Code keybindings.json  →  ~/.config/Code/User/keybindings.json
    //  Linux + GNOME + HHKB.
    //
    //  Three layers, and this file is the thinnest one:
    //    1. Super       belongs to GNOME: apps and workspaces (gnome/settings.sh).
    //                   Nothing here uses it.
    //    2. SPC leader  in normal mode does the real work — files, search,
    //                   splits, rename, format, debug, git, notebooks. Defined
    //                   in the vim.g.vscode branch of nvim/init.lua, so it's
    //                   the same muscle memory as Doom and standalone nvim.
    //    3. Ctrl        only for what must work OUTSIDE normal mode: moving
    //                   between panes/sidebar/terminal, run, completion.
    //
    //  Rules held: no Alt, no F-keys, no arrows.
    //
    //  Stock Linux VS Code chords that start with Ctrl+K (Ctrl+K Ctrl+S for
    //  the shortcuts editor, etc.) are shadowed by Ctrl+K below. They're all
    //  still in the command palette: Ctrl+Shift+P.
    // ═══════════════════════════════════════════════════════════════════════


    // ── PANES ──────────────────────────────────────────────────────────────
    // Same keys as tmux + nvim (vim-tmux-navigator) and Doom. navigate* crosses
    // out of the editor grid into the terminal panel and the sidebar too.
    // Skipped in insert mode so Ctrl+H stays backspace and Ctrl+J newline.
    { "key": "ctrl+h", "command": "workbench.action.navigateLeft",  "when": "!editorTextFocus || neovim.mode != insert" },
    { "key": "ctrl+j", "command": "workbench.action.navigateDown",  "when": "!editorTextFocus || neovim.mode != insert" },
    { "key": "ctrl+k", "command": "workbench.action.navigateUp",    "when": "!editorTextFocus || neovim.mode != insert" },
    { "key": "ctrl+l", "command": "workbench.action.navigateRight", "when": "!editorTextFocus || neovim.mode != insert" },

    // Splits, close, zoom: SPC w v / SPC w s / SPC w d / SPC w m in normal mode.
    // vscode-neovim also understands C-w v, C-w s, C-w q natively.


    // ── TERMINAL ───────────────────────────────────────────────────────────
    // Ctrl+; toggles the integrated terminal from anywhere, including from
    // inside it. Stock is Ctrl+` — backtick is a corner key on the HHKB.
    { "key": "ctrl+;", "command": "workbench.action.terminal.toggleTerminal" },


    // ── RUN ────────────────────────────────────────────────────────────────
    // Ctrl+Enter runs the file; in a notebook it keeps the stock meaning
    // (run cell). SPC <CR> does the same from normal mode.
    {
        "key": "ctrl+enter",
        "command": "code-runner.run",
        "when": "editorTextFocus && !notebookEditorFocused && !findInputFocussed && !replaceInputFocussed"
    },
    { "key": "ctrl+shift+enter", "command": "code-runner.stop" },


    // ── LSP ────────────────────────────────────────────────────────────────
    // Ctrl+] is Vim's jump-to-tag: same finger, same meaning. Replaces F12.
    { "key": "ctrl+]", "command": "editor.action.revealDefinition", "when": "editorTextFocus" },
    { "key": "ctrl+shift+]", "command": "editor.action.peekDefinition", "when": "editorTextFocus" },


    // ── LINE START / END IN INSERT MODE ────────────────────────────────────
    // Insert mode only, so normal-mode Ctrl+A (increment) and Ctrl+E (scroll)
    // stay Neovim's. Matches the zsh/readline keys.
    { "key": "ctrl+a", "command": "cursorLineStart", "when": "editorTextFocus && neovim.mode == insert" },
    { "key": "ctrl+e", "command": "cursorLineEnd",   "when": "editorTextFocus && neovim.mode == insert" },


    // ── COMPLETION ─────────────────────────────────────────────────────────
    // Tab accepts, Enter always inserts a newline (pairs with
    // "editor.acceptSuggestionOnEnter": "off" in settings.json).
    { "key": "tab", "command": "acceptSelectedSuggestion", "when": "suggestWidgetVisible && textInputFocus" }

    // Escape is NOT rebound anywhere. It has to reach Neovim untouched.
]
