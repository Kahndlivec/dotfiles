# Optional. NOT enabled by default — saving notes is a manual step (SPC n p).
# Turn it on with:  systemctl --user enable --now notes-sync.timer
[Unit]
Description=Save notes every 15 minutes (optional)

[Timer]
OnStartupSec=3min
OnUnitActiveSec=15min
Persistent=true

[Install]
WantedBy=timers.target
