# ═══════════════════════════════════════════════════════════════════
#  ~/.config/ghostty/config.ghostty  →  symlink to dotfiles/ghostty/config.ghostty
#
#  tmux owns splits, tabs and sessions. Ghostty's job is to be a fast,
#  plain window and stay out of the way — so this file is short on
#  purpose. Almost every Ghostty default is already correct.
#
#  Super+T raises this window (GNOME run-or-raise, gnome/settings.sh).
#  Reload after editing:  Ctrl+Shift+,
# ═══════════════════════════════════════════════════════════════════

font-family = JetBrainsMono Nerd Font Mono
font-size = 12
theme = Monokai Pro

# Closing the window loses nothing — the tmux session keeps running and
# `ta` brings it back. So the "are you sure?" dialog is just friction.
confirm-close-surface = false

# Land straight in tmux: attach to session "main", or create it.
# Comment out if you ever want a bare shell in new windows.
command = tmux new-session -A -s main

# Minimal chrome on GNOME: title bar disappears when maximised.
gtk-titlebar-hide-when-maximized = true
window-padding-x = 6
window-padding-y = 4

# Keep Ghostty's own splits/tabs off the keyboard so nothing competes
# with tmux. Copy/paste stay on Ctrl+Shift+C / Ctrl+Shift+V (defaults).
keybind = ctrl+shift+t=unbind
keybind = ctrl+shift+o=unbind
keybind = ctrl+shift+e=unbind

# ─── Built in, no config needed ────────────────────────────────────
#   Ctrl+Shift+N   new window         Ctrl+Shift+F  search scrollback
#   Ctrl+= / - / 0 font size          Ctrl+Shift+,  reload this file
