# ~/.ssh/config — copied (not symlinked) by install.sh, because ssh is
# strict about permissions on this file.

# The desktop tower, over Tailscale — use from the ThinkPad.
Host khandlab
    HostName khandlab.tailf80156.ts.net
    User khand

# Same box for TRAMP and `eh`: `/ssh:homelab:~/`. TRAMP parses the remote
# shell prompt, and a TTY confuses it.
Host homelab
    HostName khandlab.tailf80156.ts.net
    User khand
    RequestTTY no

Host homelab-lan
    HostName 192.168.99.250
    User khand
    RequestTTY no

# Defaults for every host — kept last, since ssh takes the FIRST value it
# sees for each option.
# ControlMaster keeps one authenticated connection open per host and reuses
# it. The single biggest factor in whether TRAMP editing feels instant.
Host *
    AddKeysToAgent yes
    IdentityFile ~/.ssh/id_ed25519
    ControlMaster auto
    ControlPath ~/.ssh/cm/%r@%h:%p
    ControlPersist 10m
    ServerAliveInterval 30
    ServerAliveCountMax 3
