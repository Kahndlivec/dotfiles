# ALLOWLIST. Everything is ignored unless explicitly un-ignored below.
#
# A blacklist ("ignore .ssh, ignore .env, …") only protects you from the leaks
# you thought of in advance. With an allowlist, forgetting means "not
# committed", not "pushed to GitHub". Adding a new config = one `!` line.
*

# …but always descend into directories, or the rules below can never match.
!*/

# Repo scaffolding
!.gitignore
!README.md
!install.sh
!packages/*.txt
!gnome/*.sh
!bin/*
!gnome/shortcuts.conf
!people/**
!env/*.conf
!systemd/*.service
!systemd/*.timer

# Configs
!zsh/.zshrc
!zsh/.zprofile
!git/.gitconfig
!ghostty/config.ghostty
!tmux/.tmux.conf
!starship/starship.toml
!clang-format/.clang-format
!gh/config.yml
!vscode/*.json
!nvim/**
!sioyek/*.config
# Sublime Text: settings are copied from sublime/payload by sublime/install.sh.
!sublime/**
# Parked: the old Doom Emacs setup. install.sh never touches it.
!emacs/**

# Folders that are yours to fill, contents unpredictable.
!hhkb/**
!assets/**
!docs/**

# ── Never, under any circumstances ──────────────────────────────────────────
# After the allow rules, because last match wins.
.netrc
.npmrc
*.pem
*.key
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*
*.ppk
.env
.env.*
*_history
*.tar.gz

# Doom build artefacts and per-machine overrides — never portable.
emacs/doom/.local/
emacs/doom/eln-cache/
emacs/**/*.elc
emacs/**/*.eln
emacs/doom/custom.el
emacs/doom/+local.el

# Sublime's per-machine session state, should it ever land in the repo.
*.sublime-workspace

# ── SSH: config and known_hosts are safe and wanted ─────────────────────────
# Listed last so they win over the id_* block above. Keys are per machine
# and generated by install.sh — never committed, not even public ones.
!ssh/config
