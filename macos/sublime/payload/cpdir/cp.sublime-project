{
    // ═══════════════════════════════════════════════════════════════════════
    //  Lives at ~/Documents/cp/cp.sublime-project
    //  Open with: Project → Open Project…   (not File → Open Folder)
    //
    //  What it buys you: Sublime remembers the build system, the sidebar
    //  layout and these settings PER PROJECT. Build system choice is
    //  per-window, so without this you re-pick it every new window and get
    //  "No build system" at the worst possible moment.
    //
    //  Deliberately does NOT embed a build system. Your flags already live in
    //  three files that must agree (C++ CP.sublime-build, the FOC settings,
    //  clangd's config.yaml) — embedding a fourth copy here is how they drift.
    //  Instead: open this project once, then Tools → Build System → C++ CP.
    //  Sublime stores that choice in the .sublime-workspace beside this file
    //  and never asks again.
    // ═══════════════════════════════════════════════════════════════════════

    "folders":
    [
        {
            "path": ".",

            // Compiled binaries clutter ⌘P badly — every build drops a
            // <name>_dbg next to the source.
            "file_exclude_patterns":
            [
                "*_dbg", "*_g", "*_foc", "*.o", "*.out", "a.out",
                "*.dSYM", "*.gch", "*.pch"
            ],

            // FOC writes test data to "<source>:tests" files — left visible on
            // purpose, you want to see which problems have saved tests.
            "folder_exclude_patterns":
            [
                "*.dSYM", ".git", "_to_delete*"
            ]
        }
    ],

    "settings":
    {
        // ── C++ / CP specific ──────────────────────────────────────────────
        "tab_size": 4,
        "translate_tabs_to_spaces": true,
        "trim_trailing_white_space_on_save": "not_on_caret",
        "ensure_newline_at_eof_on_save": true,

        // Contest code is wide. 80 is a lie you tell yourself.
        "rulers": [100],
        "word_wrap": false,

        // ── Autocomplete, tuned so cp+Tab stays predictable ───────────────
        // Keep commit-on-tab TRUE: the User keymap's tab binding runs before
        // it, so the template wins and normal completions still commit on Tab.
        "auto_complete": true,
        "auto_complete_commit_on_tab": true,

        // Don't let the popup fire on one character — that's what made Tab
        // feel random. Two characters means `cp` is the first trigger point.
        "auto_complete_delay": 50,

        // ── Vim comfort ───────────────────────────────────────────────────
        "caret_style": "solid",
        "block_caret": true,
        "highlight_line": true,

        // NeoVintageous reads ~/…/Packages/User/.neovintageousrc regardless;
        // this just makes the mode indicator readable.
        "line_padding_top": 1,
        "line_padding_bottom": 1
    }
}
