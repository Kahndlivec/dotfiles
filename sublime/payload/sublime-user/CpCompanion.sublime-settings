{
    // ═══════════════════════════════════════════════════════════════════════
    //  Competitive Companion listener (cp_companion.py).
    //  Click the extension's green plus on a problem page: the problem folder
    //  is created here and the solution file opens in Sublime.
    //  Changes apply to the next problem you send; no restart needed.
    // ═══════════════════════════════════════════════════════════════════════

    // Listen whenever Sublime is open. SPC k c toggles it for the session.
    "enabled": true,

    // 10043 is one of the ports the extension sends to out of the box, so
    // the extension needs no setting.
    "port": 10043,

    // Your competitive-programming repo.
    "root": "__CP_ROOT__",

    // Where a problem goes inside it. Folders are created as needed.
    //   {folder}   the set you are working in: the top-level folder of the
    //              file open in Sublime; failing that, the one whose .cpp
    //              files changed most recently; failing that, the site name
    //   {id}       the judge's code for the problem: 2019A, abc370_a; for
    //              sites without one, the title as a slug
    //   {site}     codeforces, atcoder, cses, kattis …
    //   {contest}  2019, abc370   {problem}  A, B1   {name}  a-max-plus-size
    // Codeforces 2019 A, while working in random-100  →  random-100/2019A/2019A.cpp
    "path": "{folder}/{id}/{id}.cpp",

    // Top-level folders that are never treated as a problem set.
    "not_sets": ["algo", "notes"],

    // The file every new solution starts from.
    "template": "__CP_ROOT__/algo/cp.cpp"
}
