" ═══════════════════════════════════════════════════════════════════════════
"  .neovintageousrc  —  ~/.config/sublime-text/Packages/User/.neovintageousrc
"  Reload without restarting:  Ctrl+Shift+P → "NeoVintageous: Reload Config"
"
"  Two layers:
"    Ctrl    what must work in every mode: panes, build, run. Those live in
"            Default (Linux).sublime-keymap, not here.
"    Space   the leader, normal mode. THE SAME MAP AS nvim/init.lua (and so
"            as VS Code, which borrows it): SPC f files, SPC b buffers,
"            SPC s search, SPC w windows, SPC c code, SPC t toggles, SPC q quit.
"            If you change a key here, change it there.
"
"  Assumes the HHKB as set up for Linux:
"    Control key (row 3 far left) = Ctrl    ← cheap, home row, left pinky
"    Two left of Space            = Super   ← GNOME's key; never bound here
"    ◇ left of Space              = Fn      ← Fn+hjkl = arrows, everywhere
"    ◇ right of Space             = Alt     ← never bound here
" ═══════════════════════════════════════════════════════════════════════════

" ── Core options ───────────────────────────────────────────────────────────
set ignorecase                  " /foo matches Foo
set smartcase                   " ...but /Foo matches only Foo
set incsearch
set hlsearch                    " Esc in normal mode clears it
set wrapscan
set scrolloff=5                 " cursor never touches the screen edge
set relativenumber
set number                      " hybrid: absolute current line, relative around
set belloff=all
" The system clipboard is "vintageous_use_sys_clipboard": true in
" Preferences.sublime-settings. NeoVintageous has no `clipboard` option, so
" the `set clipboard=unnamed` line from the Mac file did nothing and is gone.
set winaltkeys=menu

let g:highlightedyank = 1
let g:highlightedyank_duration = 300

" Built-in NeoVintageous plugins:
"   surround (cs"' ds( ysiw)) · commentary (gcc gcap) · unimpaired (]q [q ]b)
"   abolish (crs crc cru) · targets (ci( from anywhere on the line)
let g:sneak = 1                 " s{char}{char} — 2-char jump

" ── Leader = Space ─────────────────────────────────────────────────────────
" Biggest key on the board, thumbs already parked. Still types a space in
" insert mode.
let mapleader=<Space>

" ═══════════════════════════════════════════════════════════════════════════
"  ESCAPE
"  HHKB puts Esc at top-left where ` normally lives — the best Esc placement
"  that exists. Use it. With Control back on home row, C-[ is also a real
"  option now. jk is the third fallback; pick one and stop thinking about it.
" ═══════════════════════════════════════════════════════════════════════════
" [jk removed - real ~200ms stall on every j you type in
"  insert mode, and j is a C++ loop variable. Use Ctrl-[.]
" inoremap jk <Esc>
" [jk removed - real ~200ms stall on every j you type in
"  insert mode, and j is a C++ loop variable. Use Ctrl-[.]
" cnoremap jk <Esc>

" ═══════════════════════════════════════════════════════════════════════════
"  hjkl — no escape hatches
"  Your Fn layer now puts real arrow keycodes on Fn+hjkl, so arrows and hjkl
"  are literally the same finger positions. In normal mode you just drop the
"  Fn. Which means there is zero reason for an arrow key to ever fire here.
"  Delete these six lines in ~2 weeks; you won't notice they're gone.
" ═══════════════════════════════════════════════════════════════════════════
nnoremap <Up>    <Nop>
nnoremap <Down>  <Nop>
nnoremap <Left>  <Nop>
nnoremap <Right> <Nop>
vnoremap <Up>    <Nop>
vnoremap <Down>  <Nop>

" Move by visual line on wrapped lines — matches what your eyes see.
nnoremap j gj
nnoremap k gk

" H / L as line start / end. `^` and `$` are shifted, awkward keys you'd
" otherwise hit a hundred times an hour.
" [H/L reverted to vanilla: screen-top / screen-bottom, with M in
"  the middle. They mean that in every vim you did not configure -
"  ssh, someone else's machine, less, man, vimium. Use 0 and $.
"  Delete the leading " on the six lines below to restore.]
" nnoremap H ^
" nnoremap L $
" vnoremap H ^
" vnoremap L $
" onoremap H ^
" onoremap L $

" ═══════════════════════════════════════════════════════════════════════════
"  CONTROL CHORDS — the reason Control went back on the home row
"  These are the in-flow, burst-fired keys. Now they cost nothing.
" ═══════════════════════════════════════════════════════════════════════════

" Half-page scroll, cursor recentred. Fired in bursts while reading code —
" this is THE chord that justifies Control's position.
nnoremap <C-d> <C-d>zz
nnoremap <C-u> <C-u>zz

" Search results and big jumps land centred too.
nnoremap n nzzzv
nnoremap N Nzzzv
nnoremap G Gzz
nnoremap <C-o> <C-o>zz
nnoremap <C-i> <C-i>zz

" Window nav (<C-h/j/k/l>) is NOT mapped here on purpose — the Sublime keymap
" binds those to Origami's travel_to_pane instead, so they work in insert mode
" too, not just normal. <C-w>v, <C-w>s, <C-w>c work natively.

" ═══════════════════════════════════════════════════════════════════════════
"  EDITING QUALITY OF LIFE
" ═══════════════════════════════════════════════════════════════════════════

" Keep cursor in place when joining lines.
nnoremap J mzJ`z

" Don't clobber the yank register when pasting over a selection.
vnoremap p "_dP

" Delete WITHOUT losing what you just yanked: SPC d then a motion.
nnoremap <leader>d "_d
vnoremap <leader>d "_d

" Indent and stay in visual mode — repeatable.
vnoremap < <gv
vnoremap > >gv

" Move selected lines up/down. (No Alt bindings, so these live on the leader.)
vnoremap <leader>j :m '>+1<CR>gv=gv
vnoremap <leader>k :m '<-2<CR>gv=gv

" Select the whole buffer.
nnoremap <leader>a ggVG

" Q replays macro q instead of opening Ex mode, which nobody wants.
nnoremap Q @q

" Diagnostics, next / previous. ]c and [c (git changes) are built in.
nnoremap ]d :LspNextDiagnostic<CR>
nnoremap [d :LspPrevDiagnostic<CR>

" ═══════════════════════════════════════════════════════════════════════════
"  THE LEADER MAP — same groups, same letters as nvim/init.lua
"
"  Sublime has no which-key popup, so the list is also in sublime/README.md.
"  A few Neovim keys have no Sublime counterpart and are simply absent:
"  SPC g (git), SPC d b/c/s (debugger), SPC m (harpoon), SPC w o.
" ═══════════════════════════════════════════════════════════════════════════

" ── Top level ──────────────────────────────────────────────────────────────
" SPC SPC / SPC .  find file        SPC ,  switch buffer        SPC e  sidebar
" The picker is Sublime's Goto Anything: open files come first, then the rest
" of the project, most recent on top. So "find file", "switch buffer" and
" "recent files" are one list here.
nnoremap <leader><leader> :ShowOverlay overlay=goto show_files=true<CR>
nnoremap <leader>. :ShowOverlay overlay=goto show_files=true<CR>
nnoremap <leader>, :ShowOverlay overlay=goto show_files=true<CR>
nnoremap <leader>e :ToggleSideBar<CR>
" SPC Enter — build and run: FOC compiles and opens the test panel.
nnoremap <leader><CR> :ViewTester action=make_opd use_debugger=false<CR>

" ── SPC f — file ───────────────────────────────────────────────────────────
nnoremap <leader>ff :ShowOverlay overlay=goto show_files=true<CR>
nnoremap <leader>fr :ShowOverlay overlay=goto show_files=true<CR>
nnoremap <leader>fs :w<CR>
nnoremap <leader>fS :wall<CR>
nnoremap <leader>fn :NewFile<CR>
" Open this file (the config).
nnoremap <leader>fp :Neovintageous action=open_rc_file<CR>

" ── SPC b — buffer ─────────────────────────────────────────────────────────
nnoremap <leader>bb :ShowOverlay overlay=goto show_files=true<CR>
nnoremap <leader>bd :Close<CR>
nnoremap <leader>bo :tabonly<CR>
nnoremap <leader>bn :bnext<CR>
nnoremap <leader>bp :bprevious<CR>

" ── SPC s — search ─────────────────────────────────────────────────────────
nnoremap <leader>ss :ShowOverlay overlay=goto text=@<CR>
nnoremap <leader>sS :GotoSymbolInProject<CR>
" Search project, and replace in project: the same panel has both fields.
nnoremap <leader>sp :ShowPanel panel=find_in_files<CR>
nnoremap <leader>sr :ShowPanel panel=find_in_files<CR>
nnoremap <leader>sb /
nnoremap <leader>sd :LspShowDiagnosticsPanel<CR>

" ── SPC w — window (pane) ──────────────────────────────────────────────────
" Ctrl+h/j/k/l also moves between panes, in every mode.
nnoremap <leader>wv :vsplit<CR>
nnoremap <leader>ws :split<CR>
nnoremap <leader>wh <C-w>h
nnoremap <leader>wj <C-w>j
nnoremap <leader>wk <C-w>k
nnoremap <leader>wl <C-w>l
nnoremap <leader>wH :CarryFileToPane direction=left<CR>
nnoremap <leader>wL :CarryFileToPane direction=right<CR>
" Close the pane; its files move to the neighbouring pane, as in Vim.
nnoremap <leader>wd :DestroyPane direction=self<CR>
nnoremap <leader>wm :ToggleZoomPane fraction=0.9<CR>
nnoremap <leader>w= <C-w>=

" ── SPC c — code ───────────────────────────────────────────────────────────
nnoremap <leader>cd :LspSymbolDefinition<CR>
nnoremap <leader>cD :LspSymbolDeclaration<CR>
nnoremap <leader>cR :LspSymbolReferences<CR>
nnoremap <leader>ci :LspSymbolImplementation<CR>
nnoremap <leader>ct :LspSymbolTypeDefinition<CR>
nnoremap <leader>cr :LspSymbolRename<CR>
nnoremap <leader>ca :LspCodeActions<CR>
vnoremap <leader>ca :LspCodeActions<CR>
nnoremap <leader>cf :LspFormatDocument<CR>
" Build and run / compile only / sanitizers / judge flags. The variant
" names are the "name" fields in C++ CP.sublime-build.
nnoremap <leader>cc :ViewTester action=make_opd use_debugger=false<CR>
nnoremap <leader>cC :Build variant=compile<CR>
nnoremap <leader>cs :Build<CR>
nnoremap <leader>cj :Build variant=judge<CR>
" New solution: wipe the buffer and drop into insert. Then type cp + Tab.
nnoremap <leader>cn ggdGi

" ── SPC o — open ───────────────────────────────────────────────────────────
nnoremap <leader>oe :RevealInSideBar<CR>
nnoremap <leader>op :ToggleSideBar<CR>

" ── SPC t — toggle ─────────────────────────────────────────────────────────
nnoremap <leader>tn :ToggleSetting setting=relative_line_numbers<CR>
nnoremap <leader>tw :ToggleSetting setting=word_wrap<CR>
nnoremap <leader>ts :ToggleSetting setting=spell_check<CR>

" ── SPC q — quit ───────────────────────────────────────────────────────────
nnoremap <leader>qq :qall<CR>
nnoremap <leader>qQ :qall!<CR>

" ── SPC h — help ───────────────────────────────────────────────────────────
" Reload this file after editing it.
nnoremap <leader>hr :Neovintageous action=reload_rc_file<CR>

" ── SPC k — competitive (Sublime only: the FOC extras) ─────────────────────
" SPC k p  toggle the test panel
nnoremap <leader>kp :ViewTester action=sync_opdebugs<CR>
" SPC k s / S  FOC's stress tester, start / stop. For A.cpp it needs
" A__Good.cpp and A__Generator.cpp beside it.
nnoremap <leader>ks :StressManager action=make_stress<CR>
nnoremap <leader>kS :StressManager action=stop_stress<CR>
" SPC k f  pick a template from the algo/ folder of your CP repo
nnoremap <leader>kf :OlympicFuncs action=show_funcs<CR>
" SPC k c  Competitive Companion listener on / off (it is on by default;
" cp_companion.py). Click the extension's green plus on a problem page.
nnoremap <leader>kc :CpCompanionToggle<CR>
