{
    // Everything runs in Sublime's panel except "Debug, interactive",
    // which opens Ghostty because the panel cannot accept typed input.
    "shell_cmd": "clang++ -std=c++20 -I__CP_HOME__/.cp/include -O1 -g -Wall -Wextra -Wshadow -Wfloat-equal -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer -DLOCAL '${file}' -o '${file_path}/${file_base_name}_dbg' && '${file_path}/${file_base_name}_dbg'",

    "file_regex": "^(..[^:]*):([0-9]+):?([0-9]+)?:? (.*)$",
    "working_dir": "${file_path}",
    "selector": "source.c++",

    "variants":
    [
        {
            "name": "Debug + in.txt",
            "shell_cmd": "clang++ -std=c++20 -I__CP_HOME__/.cp/include -O1 -g -Wall -Wextra -Wshadow -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer -DLOCAL '${file}' -o '${file_path}/${file_base_name}_dbg' && '${file_path}/${file_base_name}_dbg' < '${file_path}/in.txt'"
        },
        {
            "name": "Debug, interactive",
            "shell_cmd": "clang++ -std=c++20 -I__CP_HOME__/.cp/include -O1 -g -Wall -Wextra -Wshadow -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer -DLOCAL '${file}' -o '${file_path}/${file_base_name}_dbg' && bash __CP_HOME__/.cp/run-term.sh '${file_path}' './${file_base_name}_dbg'"
        },
        {
            "name": "Fast + in.txt",
            "shell_cmd": "clang++ -std=c++20 -I__CP_HOME__/.cp/include -O2 -Wall -Wextra -DLOCAL '${file}' -o '${file_path}/${file_base_name}' && time '${file_path}/${file_base_name}' < '${file_path}/in.txt'"
        },
        {
            "name": "Fast (release)",
            "shell_cmd": "clang++ -std=c++20 -I__CP_HOME__/.cp/include -O2 -Wall -Wextra -DLOCAL '${file}' -o '${file_path}/${file_base_name}' && '${file_path}/${file_base_name}'"
        },
        {
            "name": "g++ (matches the judge)",
            "shell_cmd": "bash __CP_HOME__/.cp/judge.sh '${file}'"
        },
        {
            "name": "Stress test vs brute.cpp",
            "shell_cmd": "bash __CP_HOME__/.cp/stress.sh '${file}' 1000"
        },
        {
            "name": "Compile only",
            "shell_cmd": "clang++ -std=c++20 -I__CP_HOME__/.cp/include -Wall -Wextra -Wshadow -fsyntax-only '${file}' && echo 'OK - compiles clean'"
        }
    ]
}
