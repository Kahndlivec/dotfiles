[
    // ═══════════════════════════════════════════════════════════════════════
    //  Sublime keymap — Linux + GNOME + HHKB. Ported from Default (OSX).
    //
    //  Same three layers as vscode/keybindings.json:
    //    Super   belongs to GNOME (apps, workspaces). Nothing here uses it.
    //    Space   the leader, normal mode. Files, buffers, search, windows,
    //            code. Same map as Neovim; it lives in .neovintageousrc.
    //    Ctrl    what must work in every mode — panes, build, run. This file.
    //  Still no Alt, no F-keys, no arrows.
    //
    //  Coming from the Mac file: every ⌘ key is now Ctrl (⌘B → Ctrl+B), and
    //  the ⌘K chords are gone — their jobs are on the leader, because Ctrl+K
    //  is "pane up" here, in tmux, in VS Code and in Neovim.
    //
    //  Stock Sublime chords that start with Ctrl+K (Ctrl+K Ctrl+B etc.) are
    //  shadowed by "pane up". They are all in the palette: Ctrl+Shift+P.
    // ═══════════════════════════════════════════════════════════════════════


    // ── PANES (Origami) ────────────────────────────────────────────────────
    // Live in every mode, insert included. Same keys as tmux and Neovim.
    // Split / close / zoom panes: SPC w v, SPC w s, SPC w d, SPC w m.
    { "keys": ["ctrl+h"], "command": "travel_to_pane", "args": {"direction": "left"} },
    { "keys": ["ctrl+j"], "command": "travel_to_pane", "args": {"direction": "down"} },
    { "keys": ["ctrl+k"], "command": "travel_to_pane", "args": {"direction": "up"} },
    { "keys": ["ctrl+l"], "command": "travel_to_pane", "args": {"direction": "right"} },


    // ── SAVE ───────────────────────────────────────────────────────────────
    // Bound here because NeoVintageous takes every Ctrl+letter in normal mode
    // and has no meaning for Ctrl+S. SPC f s does the same.
    { "keys": ["ctrl+s"], "command": "save", "args": {"async": true} },


    // ── BUILD / RUN ────────────────────────────────────────────────────────
    // Ctrl+B is the default build (debug + sanitizers). It replaces Vim's
    // page-up; use Ctrl+U instead.
    //
    // ⚠ Every "variant" string below MUST appear verbatim as a "name" in
    //   C++ CP.sublime-build. A mismatch fails silently. install.sh checks it.
    { "keys": ["ctrl+b"], "command": "build" },
    { "keys": ["ctrl+shift+r"], "command": "build", "args": {"variant": "debug-in"} },
    { "keys": ["ctrl+shift+c"], "command": "build", "args": {"variant": "fast-in"} },
    { "keys": ["ctrl+shift+t"], "command": "build", "args": {"variant": "interactive"} },
    { "keys": ["ctrl+shift+s"], "command": "build", "args": {"variant": "stress"} },
    { "keys": ["ctrl+shift+k"], "command": "build", "args": {"variant": "compile"} },
    { "keys": ["ctrl+shift+g"], "command": "build", "args": {"variant": "judge"} },

    // Compile-error navigation without F4.
    { "keys": ["ctrl+'"], "command": "next_result" },
    { "keys": ["ctrl+shift+'"], "command": "prev_result" },


    // ── LSP / clangd ───────────────────────────────────────────────────────
    // Ctrl+] is Vim's jump-to-tag. Ctrl+O jumps back.
    { "keys": ["ctrl+]"], "command": "lsp_symbol_definition" },
    { "keys": ["ctrl+shift+a"], "command": "lsp_show_diagnostics_panel" },
    // Everything else LSP is on SPC c: d definition, R references, r rename,
    // a code action, f format. (Ctrl+Shift+U, the Mac's find-references key,
    // is Ubuntu's Unicode input.)


    // ── CppFastOlympicCoding ───────────────────────────────────────────────
    // Ctrl+Enter — RUN & TEST from the source file. Same key as VS Code.
    { "keys": ["ctrl+enter"], "command": "view_tester",
      "args": {"action": "make_opd", "use_debugger": false},
      "context": [{"key": "selector", "operator": "not_equal", "operand": "source.TestSyntax", "match_all": true}] },

    // Inside the test panel the keys are FOC's own Linux defaults. They are
    // repeated here because NeoVintageous also claims Ctrl+Enter, Ctrl+V,
    // Ctrl+D and Ctrl+X, and Packages/User is the only file that outranks it.
    //     Ctrl+Enter         new test, and again to finish typing it
    //     Ctrl+V             paste the clipboard as test input
    //     Ctrl+X             kill the running program
    //     Ctrl+D             delete the selected test
    //     Ctrl+Shift+Enter   run everything again (this one is yours)
    { "keys": ["ctrl+enter"], "command": "test_manager", "args": {"action": "new_test"},
      "context": [
        {"key": "selector", "operator": "equal", "operand": "source.TestSyntax", "match_all": true},
        {"key": "setting.edit_mode", "operator": "equal", "operand": false}
      ] },
    { "keys": ["ctrl+enter"], "command": "test_manager", "args": {"action": "toggle_new_test"},
      "context": [
        {"key": "selector", "operator": "equal", "operand": "source.TestSyntax", "match_all": true},
        {"key": "setting.edit_mode", "operator": "equal", "operand": true}
      ] },
    { "keys": ["ctrl+v"], "command": "test_manager", "args": {"action": "insert_cb"},
      "context": [
        {"key": "selector", "operator": "equal", "operand": "source.TestSyntax", "match_all": true},
        {"key": "setting.edit_mode", "operator": "equal", "operand": false}
      ] },
    { "keys": ["ctrl+x"], "command": "test_manager", "args": {"action": "kill_proc"},
      "context": [{"key": "selector", "operator": "equal", "operand": "source.TestSyntax", "match_all": true}] },
    { "keys": ["ctrl+d"], "command": "test_manager", "args": {"action": "delete_tests"},
      "context": [{"key": "selector", "operator": "equal", "operand": "source.TestSyntax", "match_all": true}] },
    { "keys": ["ctrl+shift+enter"], "command": "test_manager",
      "args": {"action": "make_opd", "load_session": true, "use_debugger": false},
      "context": [{"key": "selector", "operator": "equal", "operand": "source.TestSyntax", "match_all": true}] },

    // Not ported: ⌘⇧D (run under FOC's debugger). That debugger is macOS-only.
    // Test panel toggle, FOC stress and the template library are on SPC k.

    // ── cp + Tab, claimed from User ────────────────────────────────────────
    // Unchanged from the Mac. Packages/User loads last, so this wins over
    // Default's commit_completion, NeoVintageous and FOC's own Tab binding.
    //   · command_mode false — insert mode only, so Vim's normal-mode <Tab>
    //     (jump forward in the jumplist) still works.
    //   · ^\s*(\w+)$ instead of FOC's ^(\w+)$ — tolerates auto-indent.
    //   · no meta.block exclusion — `dijkstra`+Tab works inside solve().
    // If the word isn't a file in algorithms_base, FOC falls through to
    // insert_best_completion, i.e. Sublime's normal Tab.
    { "keys": ["tab"], "command": "olympic_funcs", "args": {"action": "insert_template"},
      "context": [
        {"key": "setting.command_mode", "operator": "equal", "operand": false},
        {"key": "selector", "operator": "equal", "operand": "source.c++", "match_all": true},
        {"key": "preceding_text", "operator": "regex_contains", "operand": "^\\s*(\\w+)$", "match_all": true}
      ] },

    // Listed AFTER the rule above, so for the bare word `cp` this one wins.
    // It touches no plugin: delete_word removes the trigger, insert_snippet
    // inserts the template.
    { "keys": ["tab"], "command": "run_macro_file",
      "args": {"file": "Packages/User/cp-expand.sublime-macro"},
      "context": [
        {"key": "setting.command_mode", "operator": "equal", "operand": false},
        {"key": "selector", "operator": "equal", "operand": "source.c++", "match_all": true},
        {"key": "preceding_text", "operator": "regex_contains", "operand": "\\bcp$", "match_all": true}
      ] },


    // ── TABS ───────────────────────────────────────────────────────────────
    // gt / gT and SPC b n / SPC b p do the same in normal mode. Sidebar: SPC e.
    { "keys": ["ctrl+shift+["], "command": "prev_view" },
    { "keys": ["ctrl+shift+]"], "command": "next_view" },


    // ── LINE START / END IN INSERT MODE ────────────────────────────────────
    // Insert-mode only, so NeoVintageous keeps normal-mode Ctrl+A (increment)
    // and Ctrl+E (scroll). Matches zsh/readline.
    { "keys": ["ctrl+a"], "command": "move_to", "args": {"to": "bol", "extend": false},
      "context": [{"key": "setting.command_mode", "operator": "equal", "operand": false}] },
    { "keys": ["ctrl+e"], "command": "move_to", "args": {"to": "eol", "extend": false},
      "context": [{"key": "setting.command_mode", "operator": "equal", "operand": false}] },


    // ── PANEL / POPUP HYGIENE ──────────────────────────────────────────────
    // Esc closes the build output panel without reaching for the mouse.
    { "keys": ["escape"], "command": "hide_panel", "args": {"cancel": true},
      "context": [{"key": "panel_visible", "operator": "equal", "operand": true}] },

    // Listed last so it wins over the panel rule when a popup is open.
    // This closes the POPUP only — a second Esc leaves insert mode.
    { "keys": ["escape"], "command": "hide_auto_complete",
      "context": [{"key": "auto_complete_visible", "operator": "equal", "operand": true}] }
]
