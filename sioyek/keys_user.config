# ===========================================================================
#  ~/.config/sioyek/keys_user.config  ->  symlink to dotfiles/sioyek/
#  Only the additions. Everything else is Sioyek's default (press : to search
#  every command and see its key). Plain ASCII only, like prefs_user.config.
#
#  Defaults worth knowing:
#    t        table of contents          gg / G / 42gg   first / last / page 42
#    /  n N   search, next, previous     backspace       back to where you were
#    hd hv    highlight the selection    gh              list highlights
#    gnh gNh  next / previous highlight  dh              delete (click it first)
#    b  gb    add a note / list notes    db              delete nearest note
#    o  O     open file / recent files   q               quit
#
#  In the gh list, type [v] to see only the vety, [d] only the definice, ...
# ===========================================================================

# Next / previous highlight of one colour (macros from prefs_user.config).
_next_d gnd
_prev_d gNd
_next_v gnv
_prev_v gNv
_next_p gnp
_prev_p gNp
_next_k gnk
_prev_k gNk
_next_z gnz
_prev_z gNz

# Export a copy of the PDF with your highlights and notes baked in, for the
# iPad. Save it into ~/GoogleDrive/Skripta.
embed_annotations ge

# The F-key defaults, without the Fn layer.
toggle_dark_mode gd
fit_to_page_width_smart gw
