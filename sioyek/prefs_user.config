# ===========================================================================
#  ~/.config/sioyek/prefs_user.config  ->  symlink to dotfiles/sioyek/
#  For Sioyek 2.0, the version Ubuntu ships. Saved changes apply at once.
#
#  THREE RULES, or Sioyek silently ignores the rest of the file:
#    1. Plain ASCII only. No accents, no fancy dashes, not even in comments.
#       Sioyek stops reading at the first non-ASCII character.
#    2. A comment is a line that STARTS with #. No comment after a value.
#    3. No indented lines.
#  install.sh check verifies rule 1.
# ===========================================================================

# -- Highlight colours: one letter per kind of thing ------------------------
#  Select text, then press h and the letter.
#    hd  blue    definice
#    hv  red     veta, lemma, tvrzeni, dusledek
#    hp  green   priklad or cviceni worth redoing
#    hk  yellow  the key step or trick inside a proof
#    hz  purple  flagged for the zkouska
#  Highlight only the name line ("Veta 2.5 (Bolzano-Weierstrass)"), so the
#  list (gh) reads like a table of contents.
highlight_color_d 0.35 0.65 1.00
highlight_color_v 1.00 0.40 0.40
highlight_color_p 0.40 0.90 0.50
highlight_color_k 1.00 0.85 0.20
highlight_color_z 0.80 0.50 1.00

# -- Jump to the next / previous highlight of ONE colour --------------------
#  Sioyek 2.0 cannot take the colour as part of the key, so there is one
#  macro per colour. The keys are in keys_user.config: gnd gNd, gnv gNv, ...
new_macro _next_d set_select_highlight_type(d);goto_next_highlight_of_type
new_macro _prev_d set_select_highlight_type(d);goto_prev_highlight_of_type
new_macro _next_v set_select_highlight_type(v);goto_next_highlight_of_type
new_macro _prev_v set_select_highlight_type(v);goto_prev_highlight_of_type
new_macro _next_p set_select_highlight_type(p);goto_next_highlight_of_type
new_macro _prev_p set_select_highlight_type(p);goto_prev_highlight_of_type
new_macro _next_k set_select_highlight_type(k);goto_next_highlight_of_type
new_macro _prev_k set_select_highlight_type(k);goto_prev_highlight_of_type
new_macro _next_z set_select_highlight_type(z);goto_next_highlight_of_type
new_macro _prev_z set_select_highlight_type(z);goto_prev_highlight_of_type

# -- Pages ------------------------------------------------------------------
#  A thin grey line between pages. Off by default, which makes "s. 47" in
#  your notes hard to find by eye.
page_separator_width 3
page_separator_color 0.55 0.55 0.55

# -- Behaviour --------------------------------------------------------------
check_for_updates_on_startup 0
should_load_tutorial_when_no_other_file 0
