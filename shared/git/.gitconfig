; ═══════════════════════════════════════════════════════════════════
;  shared/git/.gitconfig  ->  ~/.gitconfig
;
;  No [user] block. Four machines across two people share this repo,
;  so the identity lives in ~/.gitconfig.local, which linux/setup.sh
;  writes once per machine and which is never committed.
; ═══════════════════════════════════════════════════════════════════

[include]
	path = ~/.gitconfig.local

[init]
	defaultBranch = main

[pull]
	rebase = true

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

; git-delta is in apt.txt — side-by-side diffs with syntax highlighting.
[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	syntax-theme = Monokai Extended

[merge]
	conflictstyle = zdiff3
